{
  "$id": "config-portal-company",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "tenant",
    "contacts",
    "creci",
    "address",
    "logoFileName"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "number",
          "hasWhatsapp",
          "context"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          },
          "hasWhatsapp": {
            "type": "boolean"
          },
          "context": {
            "type": "string",
            "enum": [
              "sale",
              "rent",
              "both",
              "general"
            ]
          }
        }
      }
    },
    "address": {
      "type": "object",
      "required": [
        "street",
        "number",
        "district",
        "city",
        "state"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "complement": {
          "type": "string",
          "minLength": 1
        },
        "district": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      }
    },
    "creci": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "number"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "logoFileName": {
      "type": "string",
      "minLength": 1
    }
  }
}
